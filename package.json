{
  "name": "codex-quota-capsule-windows",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Windows Quota Capsule: Codex weekly runway gauge",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/sync-workspaces.mjs",
    "sync": "node scripts/sync-workspaces.mjs",
    "build": "npm run build -w packages/core && npm run sync && npm run build -w packages/source-codex",
    "test": "npm run build && vitest run",
    "lint": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/source-codex/tsconfig.json --noEmit",
    "refresh:once": "npm run build && node scripts/refresh-once.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
