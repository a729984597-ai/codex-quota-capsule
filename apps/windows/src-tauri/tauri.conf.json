{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Capsule Beta",
  "version": "0.1.0",
  "identifier": "com.bono.quota-capsule.beta.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quota Capsule Beta",
        "width": 280,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/scripts/refresh-once.mjs",
      "resources/packages/core/dist/**/*",
      "resources/packages/source-codex/dist/**/*",
      "resources/packages/source-cursor/dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
